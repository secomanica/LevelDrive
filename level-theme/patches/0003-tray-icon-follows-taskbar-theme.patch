@@ -580,11 +580,18 @@ QString Theme::defaultClientFolder() const
 QString Theme::systrayIconFlavor(bool mono) const
 {
     QString flavor;
+#ifdef Q_OS_WIN
+    // Level: the tray icon always follows the taskbar theme. The branded "black" set (light taskbar)
+    // uses the colored brand symbol and the "white" set (dark taskbar) its negative version.
+    Q_UNUSED(mono)
+    flavor = Utility::hasDarkSystray() ? QLatin1String("white") : QLatin1String("black");
+#else
     if (mono) {
         flavor = Utility::hasDarkSystray() ? QLatin1String("white") : QLatin1String("black");
     } else {
         flavor = QLatin1String("colored");
     }
+#endif
     return flavor;
 }
 
@@ -601,8 +608,14 @@ bool Theme::systrayUseMonoIcons() const
 
 bool Theme::monoIconsAvailable() const
 {
+#ifdef Q_OS_WIN
+    // Level: on Windows the tray icon always follows the taskbar theme (see systrayIconFlavor),
+    // so the "monochrome icons" option has no effect and is hidden in the settings.
+    return false;
+#else
     QString themeDir = QString(Theme::themePrefix) + QString::fromLatin1("%1/").arg(Theme::instance()->systrayIconFlavor(true));
     return QDir(themeDir).exists();
+#endif
 }
 
