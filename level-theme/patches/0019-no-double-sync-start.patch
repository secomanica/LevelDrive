@@ -677,6 +677,8 @@ private:
     bool _levelForeignLocksSeeded = false;
     qint64 _levelForeignLocksLastRefresh = 0;
 
+    // Level (patch 0019): startSync() was called and the engine start is still queued
+    bool _levelSyncStartQueued = false;
 
     /// The remote file ID of the current folder.
     qint64 _rootFileId = 0;
