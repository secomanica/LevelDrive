 }
 
+// Level: credit to the upstream project (GPL) and, when configured, where the source code is published.
+static QString levelCreditString()
+{
+    QString credit = QCoreApplication::translate("OCC::Theme",
+        "<p>Based on the Nextcloud Desktop Client, licensed under GPLv2.</p>");
+#ifdef APPLICATION_SOURCE_URL
+    //: %1 is the URL of the published source code of this client.
+    credit += QCoreApplication::translate("OCC::Theme", "<p>Source code: <a href=\"%1\">%1</a></p>")
+                  .arg(QStringLiteral(APPLICATION_SOURCE_URL));
+#endif
+    return credit;
+}
+
 QString Theme::gitSHA1() const
 {
     QString devString;
 #ifdef GIT_SHA1
-    const QString githubPrefix(QLatin1String(
-        "https://github.com/nextcloud/desktop/commit/"));
+    // Level: link to the published fork (APPLICATION_SOURCE_URL) instead of github.com/nextcloud
+#ifdef APPLICATION_SOURCE_URL
+    const QString revisionUrl(QStringLiteral(APPLICATION_SOURCE_URL));
+#else
+    const QString revisionUrl;
+#endif
     const QString gitSha1(QLatin1String(GIT_SHA1));
     //: %1 is the full Git commit URL. %2 is the abbreviated Git revision. %3 is the build date.
     //: %4 is the build time. %5 is the Qt version. %6 is the TLS library version.
     devString = QCoreApplication::translate("nextcloudTheme::aboutInfo()",
         "<p><small>Built from Git revision <a href=\"%1\">%2</a>"
         " on %3, %4 using Qt %5, %6</small></p>")
-                    .arg(githubPrefix + gitSha1)
+                    .arg(revisionUrl)
                     .arg(gitSha1.left(6))
                     .arg(__DATE__)
                     .arg(__TIME__)
                     .arg(qVersion())
                     .arg(QSslSocket::sslLibraryVersionString());
+    if (revisionUrl.isEmpty()) {
+        devString.remove(QStringLiteral("<a href=\"\">")).remove(QStringLiteral("</a>"));
+    }
 #endif
     return devString;
 }
