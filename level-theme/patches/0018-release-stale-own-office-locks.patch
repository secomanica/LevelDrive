+// Level (patch 0018): automatic release of our own stale office locks
+constexpr auto levelAutoLockSweepIntervalMs = 60 * 1000;
+constexpr auto levelAutoLockMinAgeSecs = 60;
+constexpr auto levelForeignLockRefreshSecs = 120;
+QString levelAutoLocksGroup()
+{
+    return QStringLiteral("LevelAutoLocks");
+}
+
+// Whether LibreOffice is running on this machine. A crashed LibreOffice leaves its lock file behind,
+// so a lock file only counts while the program runs.
+bool levelLibreOfficeRunning()
+{
+#ifdef Q_OS_WIN
+    const auto snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
+    if (snapshot == INVALID_HANDLE_VALUE) {
+        return true; // unknown: keep the lock
+    }
+    PROCESSENTRY32W entry{};
+    entry.dwSize = sizeof(entry);
+    auto running = false;
+    for (auto ok = Process32FirstW(snapshot, &entry); ok && !running; ok = Process32NextW(snapshot, &entry)) {
+        const auto name = QString::fromWCharArray(entry.szExeFile);
+        running =
+            name.compare(QStringLiteral("soffice.bin"), Qt::CaseInsensitive) == 0 || name.compare(QStringLiteral("soffice.exe"), Qt::CaseInsensitive) == 0;
+    }
+    CloseHandle(snapshot);
+    return running;
+#else
+    return true;
+#endif
+}
+
+// Whether the document is still open here: some program holds it (Microsoft Office and current
+// LibreOffice keep the document open while editing) or a LibreOffice lock file (.~lock.<name>#)
+// still points to it while LibreOffice runs (LibreOffice can be set not to hold the document).
+bool levelDocumentStillOpen(const QString &documentPath)
+{
+    if (OCC::FileSystem::isFileLocked(documentPath, OCC::FileSystem::LockMode::Exclusive)) {
+        return true;
+    }
+    if (!levelLibreOfficeRunning()) {
+        return false;
+    }
+    const QFileInfo documentInfo(documentPath);
+    const auto dir = documentInfo.dir();
+    const auto lockFiles = dir.entryList({QStringLiteral(".~lock.*")}, QDir::Files | QDir::Hidden | QDir::System);
+    for (const auto &lockFileName : lockFiles) {
+        const auto lockFilePath = dir.absoluteFilePath(lockFileName);
+        const auto pattern = OCC::FileSystem::filePathLockFilePatternMatch(lockFilePath);
+        const auto target = OCC::FileSystem::lockFileTargetFilePath(lockFilePath, pattern);
+        if (target.type == OCC::FileSystem::FileLockingInfo::Type::Locked && OCC::Utility::fileNamesEqual(target.path, documentInfo.absoluteFilePath())) {
+            return true;
+        }
+    }
+    return false;
+}
 }
 
