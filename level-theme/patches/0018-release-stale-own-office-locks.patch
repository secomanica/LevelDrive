+// Level (patch 0018): automatic release of our own stale office locks
+constexpr auto levelAutoLockSweepIntervalMs = 60 * 1000;
+constexpr auto levelAutoLockMinAgeSecs = 60;
+QString levelAutoLocksGroup()
+{
+    return QStringLiteral("LevelAutoLocks");
+}
+
+// Whether the document is still open here: some program holds it (Microsoft Office keeps the
+// document open while editing) or a LibreOffice lock file (.~lock.<name>#) still points to it
+// (LibreOffice does not keep the document open).
+bool levelDocumentStillOpen(const QString &documentPath)
+{
+    if (OCC::FileSystem::isFileLocked(documentPath, OCC::FileSystem::LockMode::Exclusive)) {
+        return true;
+    }
+    const QFileInfo documentInfo(documentPath);
+    const auto dir = documentInfo.dir();
+    const auto lockFiles = dir.entryList({QStringLiteral(".~lock.*")}, QDir::Files | QDir::Hidden | QDir::System);
+    for (const auto &lockFileName : lockFiles) {
+        const auto lockFilePath = dir.absoluteFilePath(lockFileName);
+        const auto pattern = OCC::FileSystem::filePathLockFilePatternMatch(lockFilePath);
+        const auto target = OCC::FileSystem::lockFileTargetFilePath(lockFilePath, pattern);
+        if (target.type == OCC::FileSystem::FileLockingInfo::Type::Locked && OCC::Utility::fileNamesEqual(target.path, documentInfo.absoluteFilePath())) {
+            return true;
+        }
+    }
+    return false;
+}
 }
 
