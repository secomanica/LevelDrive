+void Folder::levelSaveAutoLocks() const
+{
+    auto settings = ConfigFile::settingsWithGroup(levelAutoLocksGroup());
+    if (_levelAutoLocks.isEmpty()) {
+        settings->remove(_definition.alias);
+    } else {
+        settings->setValue(_definition.alias, QStringList{_levelAutoLocks.cbegin(), _levelAutoLocks.cend()});
+    }
+}
+
+void Folder::levelTrackForeignLock(const SyncFileItemPtr &item)
+{
+    if (!item || item->isDirectory()) {
+        return;
+    }
+    const auto lockedByOther = item->_locked == SyncFileItem::LockStatus::LockedItem && item->_lockOwnerId != _accountState->account()->davUser();
+    if (lockedByOther) {
+        _levelForeignLocks.insert(item->_file);
+    } else {
+        _levelForeignLocks.remove(item->_file);
+    }
+}
+
+void Folder::levelRefreshForeignLocks()
+{
+    const auto davUser = _accountState->account()->davUser();
+    if (!_levelForeignLocksSeeded) {
+        // locks recorded before this run (e.g. before a restart) are not rediscovered on their own
+        _levelForeignLocksSeeded = true;
+        const auto ok = _journal.getFilesBelowPath(QByteArray{}, [this, &davUser](const SyncJournalFileRecord &rec) {
+            if (rec.isFile() && rec._lockstate._locked && rec._lockstate._lockOwnerId != davUser) {
+                _levelForeignLocks.insert(rec.path());
+            }
+        });
+        if (!ok) {
+            qCWarning(lcFolder) << "Level: could not read the locks recorded in the journal";
+        }
+    }
+
+    const auto now = QDateTime::currentSecsSinceEpoch();
+    if (_levelForeignLocks.isEmpty() || now - _levelForeignLocksLastRefresh < levelForeignLockRefreshSecs || isBusy()) {
+        return;
+    }
+    _levelForeignLocksLastRefresh = now;
+
+    auto scheduled = false;
+    for (auto it = _levelForeignLocks.begin(); it != _levelForeignLocks.end();) {
+        SyncJournalFileRecord rec;
+        const auto stillLockedByOther = _journal.getFileRecord(*it, &rec) && rec.isValid() && rec._lockstate._locked && rec._lockstate._lockOwnerId != davUser;
+        if (!stillLockedByOther) {
+            it = _levelForeignLocks.erase(it);
+            continue;
+        }
+        // a lock can go away on the server without a new etag; ask the server about this folder again
+        _journal.schedulePathForRemoteDiscovery(*it);
+        scheduled = true;
+        ++it;
+    }
+    if (scheduled) {
+        qCInfo(lcFolder) << "Level: refreshing the lock state of" << _levelForeignLocks.size() << "file(s) locked by others";
+        scheduleThisFolderSoon();
+    }
+}
+
+void Folder::levelSweepAutoLocks()
+{
+    if (!_accountState->isConnected()) {
+        return;
+    }
+    levelRefreshForeignLocks();
+    if (_levelAutoLocks.isEmpty()) {
+        return;
+    }
+
+    const auto davUser = _accountState->account()->davUser();
+    const auto now = QDateTime::currentSecsSinceEpoch();
+    QSet<QString> toUnlock;
+    auto changed = false;
+
+    for (auto it = _levelAutoLocks.begin(); it != _levelAutoLocks.end();) {
+        SyncJournalFileRecord rec;
+        const auto stillOurLock = journalDb()->getFileRecord(*it, &rec) && rec.isValid() && rec._lockstate._locked
+            && rec._lockstate._lockOwnerType == static_cast<qint64>(SyncFileItem::LockOwnerType::TokenLock) && rec._lockstate._lockOwnerId == davUser;
+        if (!stillOurLock) {
+            // released, expired or taken by someone else: nothing left to do for it
+            it = _levelAutoLocks.erase(it);
+            changed = true;
+            continue;
+        }
+
+        const auto localFilePath = path() + *it;
+        if (now - rec._lockstate._lockTime >= levelAutoLockMinAgeSecs && !levelDocumentStillOpen(localFilePath)) {
+            qCInfo(lcFolder) << "Level: document no longer open, releasing our lock" << localFilePath;
+            toUnlock.insert(localFilePath);
+        }
+        ++it;
+    }
+
+    if (changed) {
+        levelSaveAutoLocks();
+    }
+    if (!toUnlock.isEmpty()) {
+        slotFilesLockReleased(toUnlock);
+    }
+}
