+// Level (patch 0021): the name shown for whoever holds a lock
+QString levelLockOwnerName(const QString &displayName, const QString &editorApp, const QString &ownerId, int ownerType)
+{
+    if (!displayName.isEmpty()) {
+        // the server appends the client name, e.g. " (Desktop Client)", to the owner of a token lock
+        const auto suffixStart = displayName.lastIndexOf(QStringLiteral(" ("));
+        if (ownerType == static_cast<int>(OCC::SyncFileItem::LockOwnerType::TokenLock) && suffixStart > 0 && displayName.endsWith(QLatin1Char(')'))) {
+            return displayName.left(suffixStart);
+        }
+        return displayName;
+    }
+    return editorApp.isEmpty() ? ownerId : editorApp;
+}
