+void Folder::levelNotifyLockedByOther(const QString &recordPath, const QString &owner, bool lostRace)
+{
+    // Lock files come and go while a document is open; one notice per document and minute is enough
+    const auto now = QDateTime::currentSecsSinceEpoch();
+    const auto lastShown = _levelLockNoticeShown.value(recordPath, 0);
+    if (now - lastShown < 60) {
+        return;
+    }
+    _levelLockNoticeShown.insert(recordPath, now);
+
+    const auto fileName = QFileInfo(recordPath).fileName();
+
+    qCInfo(lcFolder) << "Level: document opened while locked by" << owner << recordPath << "lostRace:" << lostRace;
+    if (!Systray::instance()) {
+        return;
+    }
+    if (lostRace) {
+        Systray::instance()->showMessage(tr("%1 is already open by %2").arg(fileName, owner),
+                                         tr("%1 opened it first. Your changes cannot be saved to the original: save a copy with another name.").arg(owner),
+                                         QSystemTrayIcon::Warning);
+    } else {
+        Systray::instance()->showMessage(tr("%1 is in use by %2").arg(fileName, owner),
+                                         tr("The file opens read-only until %1 closes it.").arg(owner),
+                                         QSystemTrayIcon::Information);
+    }
+}
