diff --git a/admin/win/msi/level-strings.en-us.wxl b/admin/win/msi/level-strings.en-us.wxl
new file mode 100644
index 0000000000..a989d1882c
--- /dev/null
+++ b/admin/win/msi/level-strings.en-us.wxl
@@ -0,0 +1,18 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  - SPDX-FileCopyrightText: 2026 Level Tecnologia
+  - SPDX-License-Identifier: GPL-2.0-or-later
+  -
+  - Installer strings that are not part of WixUIExtension (moved out of Nextcloud.wxs by the Level Drive
+  - theme, patch 0011). Languages without their own file fall back to these English strings.
+-->
+<WixLocalization Culture="en-us" Codepage="1252" xmlns="http://schemas.microsoft.com/wix/2006/localization">
+  <String Id="LevelProgressRemovePrevious">Removing previous installation</String>
+  <String Id="LevelProgressKillProcess">Trying to terminate application process of previous installation</String>
+  <String Id="LevelProgressRemoveNavPane">Removing sync folders from Explorer's Navigation Pane</String>
+  <String Id="LevelLaunchApp">Launch</String>
+  <String Id="LevelFeatureShellExtensions">Integration for Windows Explorer</String>
+  <String Id="LevelFeatureShellExtensionsDescription">This feature requires a reboot.</String>
+  <String Id="LevelFeatureStartMenuShortcut">Start Menu Shortcut</String>
+  <String Id="LevelFeatureDesktopShortcut">Desktop Shortcut</String>
+</WixLocalization>
